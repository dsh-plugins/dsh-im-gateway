{
  "name": "@dsh-prism/dsh-im-gateway",
  "description": "Connect Prism to seven messaging channels for private conversations and task updates.",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*",
    "locale/*.json",
    "icon.svg",
    "scripts/prism-im.mjs",
    "README.zh_CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@dsh-prism/dsh-orchestrator": "^0.2.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.3-alpha.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.release.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.77.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "discord.js": "14.28.1",
    "qrcode-terminal": "0.12.0"
  },
  "bin": {
    "prism-im": "./scripts/prism-im.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "ws": "8.23.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-im-gateway.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
